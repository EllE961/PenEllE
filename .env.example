# PenEllE Environment Configuration Example
# Copy this file to .env and update with your values

# Environment
ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql://penelle:penelle@localhost:5432/penelle
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# S3/MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=penelle
S3_REGION=us-east-1
S3_USE_SSL=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=PenEllE API
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-app-secret-key-change-in-production
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SECURE_HEADERS_ENABLED=true

# Testing (for .env.test)
TEST_DATABASE_URL=postgresql://penelle:penelle_test@localhost:5432/penelle_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_S3_BUCKET_NAME=penelle-test

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=penelle
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true

# Feature Flags
FEATURE_VECTOR_SEARCH=false
FEATURE_MULTI_LANGUAGE=false
FEATURE_ADVANCED_ANALYTICS=false