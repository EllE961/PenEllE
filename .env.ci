# Environment
ENV=test
DEBUG=false

# Database - Using service container names
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/penelle_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis - Using service container name
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=10

# S3/MinIO - Using service container name
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=penelle-test
S3_REGION=us-east-1
S3_USE_SSL=false

# JWT Authentication - Static test values
JWT_SECRET_KEY=ci-test-secret-key-not-for-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
JWT_ALGORITHM=HS256

# API Configuration
API_V1_PREFIX=/api/v1
API_TITLE=PenEllE API Test
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# LLM Providers - Empty for CI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://ollama:11434

# Logging - Less verbose for CI
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Security - Test values
SECRET_KEY=ci-test-app-secret-key
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SECURE_HEADERS_ENABLED=false

# Testing specific
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/penelle_test
TEST_REDIS_URL=redis://redis:6379/1
TEST_S3_BUCKET_NAME=penelle-test

# Monitoring - Disabled for CI
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=penelle-test
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false

# Feature Flags - All disabled for CI
FEATURE_VECTOR_SEARCH=false
FEATURE_MULTI_LANGUAGE=false
FEATURE_ADVANCED_ANALYTICS=false

# CI Specific
CI=true
GITHUB_ACTIONS=true
PYTEST_WORKERS=2
COVERAGE_THRESHOLD=90