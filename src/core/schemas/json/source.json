{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source",
  "description": "Literature source in CSL-JSON format with PenEllE extensions",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "default": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the source"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA256 hash for deduplication"
    },
    "csl_json": {
      "type": "object",
      "description": "CSL-JSON formatted bibliographic data",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["article", "article-journal", "article-magazine", "article-newspaper", "bill", "book", "broadcast", "chapter", "dataset", "entry", "entry-dictionary", "entry-encyclopedia", "figure", "graphic", "interview", "legal_case", "legislation", "manuscript", "map", "motion_picture", "musical_score", "pamphlet", "paper-conference", "patent", "personal_communication", "post", "post-weblog", "report", "review", "review-book", "song", "speech", "thesis", "treaty", "webpage"]
        },
        "id": {"type": "string"},
        "title": {"type": "string"},
        "author": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "family": {"type": "string"},
              "given": {"type": "string"}
            }
          }
        },
        "issued": {
          "type": "object",
          "properties": {
            "date-parts": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {"type": "integer"}
              }
            }
          }
        },
        "container-title": {"type": "string"},
        "volume": {"type": "string"},
        "issue": {"type": "string"},
        "page": {"type": "string"},
        "DOI": {"type": "string"},
        "URL": {"type": "string"},
        "abstract": {"type": "string"}
      },
      "required": ["type", "title"]
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Quality assessment score"
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Relevance to the thesis"
    },
    "connector_name": {
      "type": "string",
      "description": "Name of the connector that retrieved this source"
    },
    "raw_metadata": {
      "type": "object",
      "description": "Original metadata from the source connector"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["schema_version", "id", "fingerprint", "csl_json", "connector_name"],
  "additionalProperties": false
}