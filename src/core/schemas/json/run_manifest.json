{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunManifest",
  "description": "Complete manifest of a pipeline run with all artifacts",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "default": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Pipeline run ID"
    },
    "thesis": {
      "type": "string",
      "description": "The input thesis statement"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "cancelled"],
      "description": "Run status"
    },
    "pipeline_version": {
      "type": "string",
      "description": "Version of the pipeline used"
    },
    "configuration": {
      "type": "object",
      "description": "Run configuration parameters"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {"$ref": "#/definitions/artifact_reference"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/definitions/artifact_reference"}
        },
        "draft_sections": {
          "type": "array",
          "items": {"$ref": "#/definitions/artifact_reference"}
        },
        "claims": {
          "type": "array",
          "items": {"$ref": "#/definitions/artifact_reference"}
        },
        "quality_report": {"$ref": "#/definitions/artifact_reference"},
        "final_output": {"$ref": "#/definitions/artifact_reference"}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_sources": {"type": "integer", "minimum": 0},
        "total_evidence": {"type": "integer", "minimum": 0},
        "total_claims": {"type": "integer", "minimum": 0},
        "word_count": {"type": "integer", "minimum": 0},
        "quality_score": {"type": "number", "minimum": 0, "maximum": 1},
        "execution_time_seconds": {"type": "number", "minimum": 0}
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if run failed"
    }
  },
  "required": ["schema_version", "run_id", "thesis", "status", "pipeline_version", "created_at"],
  "additionalProperties": false,
  "definitions": {
    "artifact_reference": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "format": "uuid"
        },
        "filename": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
        "file_size": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_type": {
          "type": "string"
        }
      },
      "required": ["artifact_id", "filename", "file_path", "checksum"]
    }
  }
}