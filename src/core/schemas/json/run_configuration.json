{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunConfiguration",
  "description": "Configuration parameters for a pipeline run",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "default": "1.0"
    },
    "style_pack": {
      "type": "string",
      "enum": ["academic_report", "essay", "policy_brief", "news_article"],
      "default": "academic_report",
      "description": "Writing style template"
    },
    "target_word_count": {
      "type": "integer",
      "minimum": 100,
      "maximum": 50000,
      "default": 5000,
      "description": "Target word count for the output"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Output language (ISO 639-1 code)"
    },
    "source_limits": {
      "type": "object",
      "properties": {
        "max_sources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "min_quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "publication_year_range": {
          "type": "object",
          "properties": {
            "start": {"type": "integer"},
            "end": {"type": "integer"}
          }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["openalex", "semantic_scholar", "crossref", "arxiv", "pubmed", "unpaywall", "user_library"]
          },
          "enabled": {"type": "boolean", "default": true},
          "priority": {"type": "integer", "minimum": 1, "maximum": 10},
          "config": {"type": "object"}
        },
        "required": ["name"]
      },
      "description": "Source connectors configuration"
    },
    "quality_gates": {
      "type": "object",
      "properties": {
        "min_evidence_per_claim": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "min_quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "max_passive_voice_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 20
        },
        "min_readability_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 60
        }
      }
    },
    "llm_config": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["ollama", "openai", "anthropic"],
          "default": "ollama"
        },
        "model": {"type": "string"},
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["markdown", "pdf", "docx", "latex", "html"]
      },
      "default": ["markdown", "pdf"]
    },
    "advanced": {
      "type": "object",
      "properties": {
        "enable_fact_checking": {"type": "boolean", "default": true},
        "enable_adversarial_search": {"type": "boolean", "default": true},
        "enable_claim_repair": {"type": "boolean", "default": true},
        "chunk_size": {"type": "integer", "minimum": 100, "maximum": 5000, "default": 1000},
        "overlap_size": {"type": "integer", "minimum": 0, "maximum": 500, "default": 100}
      }
    }
  },
  "required": ["schema_version"],
  "additionalProperties": false
}