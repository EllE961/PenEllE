{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "description": "A claim made in the document with supporting evidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "default": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the claim"
    },
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Associated pipeline run ID"
    },
    "claim_text": {
      "type": "string",
      "description": "The actual claim statement"
    },
    "claim_type": {
      "type": "string",
      "enum": ["factual", "interpretive", "evaluative", "causal", "predictive"],
      "description": "Type of claim"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "IDs of evidence supporting this claim"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in the claim"
    },
    "verification_status": {
      "type": "string",
      "enum": ["verified", "unverified", "disputed", "retracted"],
      "description": "Verification status of the claim"
    },
    "section_id": {
      "type": "string",
      "format": "uuid",
      "description": "ID of the section containing this claim"
    },
    "position": {
      "type": "object",
      "properties": {
        "paragraph": {
          "type": "integer",
          "minimum": 0
        },
        "sentence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Position of the claim in the section"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "nli_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Natural Language Inference score"
        },
        "contradicting_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["schema_version", "id", "run_id", "claim_text", "claim_type", "supporting_evidence_ids"],
  "additionalProperties": false
}