{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchResult",
  "description": "Search result from a source connector",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "default": "1.0"
    },
    "connector_name": {
      "type": "string",
      "description": "Name of the connector that found this result"
    },
    "result_id": {
      "type": "string",
      "description": "Unique ID within the connector's results"
    },
    "relevance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Search relevance score"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "orcid": {"type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"},
          "affiliation": {"type": "string"}
        },
        "required": ["name"]
      }
    },
    "publication_date": {
      "type": "string",
      "format": "date",
      "description": "Publication date"
    },
    "abstract": {
      "type": "string",
      "description": "Document abstract or summary"
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "doi": {"type": "string"},
        "pmid": {"type": "string"},
        "arxiv_id": {"type": "string"},
        "isbn": {"type": "string"},
        "issn": {"type": "string"}
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "is_open_access": {"type": "boolean"},
        "pdf_url": {"type": "string", "format": "uri"},
        "html_url": {"type": "string", "format": "uri"},
        "repository_url": {"type": "string", "format": "uri"},
        "license": {"type": "string"}
      }
    },
    "venue": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "type": {
          "type": "string",
          "enum": ["journal", "conference", "book", "preprint", "thesis", "report", "other"]
        },
        "volume": {"type": "string"},
        "issue": {"type": "string"},
        "pages": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "citation_count": {"type": "integer", "minimum": 0},
        "altmetric_score": {"type": "number", "minimum": 0},
        "download_count": {"type": "integer", "minimum": 0}
      }
    },
    "snippet": {
      "type": "string",
      "description": "Relevant text snippet from the document"
    },
    "metadata": {
      "type": "object",
      "description": "Additional connector-specific metadata"
    }
  },
  "required": ["schema_version", "connector_name", "result_id", "title"],
  "additionalProperties": false
}